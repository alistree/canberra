{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#university-of-canberra-diploma","title":"\u582a\u57f9\u62c9\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08University of Canberra diploma\uff09\u771f\u4f2a\u6837\u672c\u7ec6\u8282\u6838\u9a8c\u4e0e\u6392\u7248\u7279\u5f81","text":"<p>\u5728\u8de8\u56fd\u4eba\u624d\u6d41\u52a8\u3001\u6d77\u5f52\u4eba\u624d\u843d\u6237\u4ee5\u53ca\u5404\u5927\u4f01\u4e8b\u4e1a\u5355\u4f4d\u7684\u4eba\u4e8b\u6863\u6848\u5ba1\u67e5\u4e2d\uff0c\u5bf9\u6d77\u5916\u9ad8\u6821\u5b66\u4f4d\u8bc1\u4e66\u7684\u771f\u5b9e\u6027\u4e0e\u5408\u89c4\u6027\u6838\u9a8c\u662f\u4e00\u9879\u4e13\u4e1a\u6027\u6781\u5f3a\u7684\u5de5\u4f5c\u3002\u582a\u57f9\u62c9\u5927\u5b66\uff08University of Canberra\uff0c\u7b80\u79f0 UC\uff09\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u9996\u5e9c\u91cd\u70b9\u7efc\u5408\u6027\u516c\u7acb\u5927\u5b66\uff0c\u5176\u9881\u53d1\u7684\u5b66\u4f4d\u8bc1\u4e66\u4e0d\u4ec5\u662f\u6bd5\u4e1a\u751f\u5b66\u672f\u6210\u5c31\u7684\u8c61\u5f81\uff0c\u66f4\u662f\u5177\u5907\u6cd5\u5f8b\u6548\u529b\u7684\u6cd5\u5b9a\u6587\u4ef6\u3002</p> <p></p> <p>\u4e3a\u4e86\u5e2e\u52a9\u7528\u4eba\u5355\u4f4d\u3001\u4eba\u529b\u8d44\u6e90\u90e8\u95e8\u4ee5\u53ca\u7b2c\u4e09\u65b9\u6838\u67e5\u673a\u6784\u9ad8\u6548\u8bc6\u522b\u8be5\u6821\u5b66\u4f4d\u8bc1\u4e66\uff0c\u672c\u6587\u5c06\u4f9d\u636e\u582a\u57f9\u62c9\u5927\u5b66\u5b98\u65b9\u9881\u53d1\u7684\u771f\u5b9e\u5b66\u4f4d\u8bc1\u4e66\u6837\u672c\uff0c\u4ece\u7248\u9762\u89c6\u89c9\u67b6\u6784\u3001\u6838\u5fc3\u9632\u4f2a\u5143\u7d20\u3001\u6587\u5b57\u6392\u7248\u4e2d\u8f74\u7ebf\u4ee5\u53ca\u5e95\u90e8\u7b7e\u7ae0\u7b49\u7ef4\u5ea6\u8fdb\u884c\u5168\u9762\u62c6\u89e3\uff0c\u63d0\u4f9b\u4e00\u4efd\u4e13\u4e1a\u5316\u7684\u5b9e\u7269\u53c2\u7167\u6838\u9a8c\u6307\u5357\u3002</p>"},{"location":"#_1","title":"\u582a\u57f9\u62c9\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u6574\u4f53\u89c6\u89c9\u67b6\u6784","text":"<p>\u4e0e\u4f20\u7edf\u6fb3\u6d32\u9ad8\u6821\u504f\u5411\u590d\u53e4\u5178\u96c5\u7684\u8bc1\u4e66\u98ce\u683c\u4e0d\u540c\uff0c\u582a\u57f9\u62c9\u5927\u5b66\u7684\u5b66\u4f4d\u8bc1\u4e66\u6574\u4f53\u8bbe\u8ba1\u66f4\u5177\u73b0\u4ee3\u611f\u4e0e\u6781\u7b80\u4e3b\u4e49\u7f8e\u5b66\u3002\u6574\u4e2a\u7248\u9762\u91c7\u7528\u6d45\u7c73\u8272\u6216\u9ad8\u767d\u5ea6\u7279\u79cd\u8bc1\u5238\u7eb8\u5f20\uff0c\u6574\u4f53\u89c6\u89c9\u4e2d\u5fc3\u4e25\u683c\u9075\u5faa\u201c\u4e2d\u5fc3\u8f74\u5bf9\u79f0\u201d\u7684\u6392\u7248\u903b\u8f91\uff0c\u7ed9\u4eba\u4ee5\u4e25\u8c28\u3001\u5927\u6c14\u7684\u89c6\u89c9\u611f\u53d7\u3002</p> <p>\u5728\u5b9e\u7269\u539f\u4ef6\u4e2d\uff0c\u7eb8\u5f20\u5177\u6709\u7279\u5b9a\u7684\u514b\u91cd\u4e0e\u5fae\u5999\u7684\u89e6\u611f\uff0c\u8fb9\u7f18\u5207\u5272\u6574\u9f50\u3002\u8bc1\u4e66\u4ece\u4e0a\u81f3\u4e0b\u4f9d\u6b21\u7531\u5b98\u65b9\u5fbd\u6807\u3001\u6cd5\u5b9a\u6388\u4e88\u5ba3\u544a\u3001\u6bd5\u4e1a\u751f\u8eab\u4efd\u4fe1\u606f\u3001\u5b66\u4f4d\u540d\u79f0\u3001\u6388\u4e88\u65f6\u95f4\u4ee5\u53ca\u5e95\u90e8\u53cc\u7b7e\u7ae0\u4e0e\u9632\u4f2a\u94a2\u5370\u7ec4\u6210\u3002</p>"},{"location":"#_2","title":"\u6838\u5fc3\u89c6\u89c9\u5143\u7d20\u4e0e\u5b98\u65b9\u5fbd\u6807\u6bd4\u5bf9","text":"<p>\u8bc1\u4e66\u9876\u90e8\u7684\u5b98\u65b9\u6807\u8bc6\u662f\u6574\u5f20\u6587\u4ef6\u6700\u9192\u76ee\u7684\u8eab\u4efd\u6807\u7b7e\uff0c\u4e5f\u662f\u6838\u9a8c\u7684\u7b2c\u4e00\u9053\u5173\u5361\u3002</p>"},{"location":"#1-the-university-logo","title":"1. \u5b98\u65b9\u5fbd\u6807\uff08The University Logo\uff09","text":"<p>\u5728\u8bc1\u4e66\u6b63\u4e0a\u65b9\u5c45\u4e2d\u4f4d\u7f6e\uff0c\u5370\u6709\u582a\u57f9\u62c9\u5927\u5b66\u7684\u5b98\u65b9\u56fe\u5f62\u5fbd\u6807\u3002\u8be5\u5fbd\u6807\u7531\u4e24\u90e8\u5206\u7ec4\u6210\uff1a * \u56fe\u5f62\u90e8\u5206\uff1a \u9876\u90e8\u4e3a\u4e00\u4e2a\u7531\u516d\u4e2a\u4e0d\u89c4\u5219\u84dd\u8272\u51e0\u4f55\u82b1\u74e3\uff08\u6216\u661f\u5f62\u5ef6\u4f38\uff09\u7ec4\u6210\u7684\u73af\u72b6\u56fe\u5f62\uff0c\u6574\u4f53\u5448\u73b0\u5929\u84dd\u8272\u6216\u6df1\u5929\u84dd\u8272\u3002 * \u6587\u5b57\u90e8\u5206\uff1a \u56fe\u5f62\u4e0b\u65b9\u4e3a\u4e24\u884c\u5927\u5199\u7684\u5927\u5b66\u540d\u79f0\u201cUNIVERSITY OF CANBERRA\u201d\uff0c\u5176\u4e2d\u201cUNIVERSITY OF\u201d\u5b57\u53f7\u8f83\u5c0f\u4e14\u5b57\u4f53\u8f83\u7ec6\uff0c\u201cCANBERRA\u201d\u5b57\u53f7\u8f83\u5927\u3001\u52a0\u7c97\uff0c\u4e24\u8005\u8272\u5f69\u901a\u5e38\u4e3a\u6df1\u7070\u8272\u6216\u9ed1\u8272\u3002 * \u6838\u9a8c\u8981\u70b9\uff1a \u771f\u5b9e\u6837\u672c\u4e2d\uff0c\u8be5\u5fbd\u6807\u7684\u5370\u5237\u6781\u5176\u7cbe\u51c6\uff0c\u5929\u84dd\u8272\u56fe\u5f62\u4e0e\u4e0b\u65b9\u6df1\u8272\u6587\u5b57\u7684\u8f74\u5fc3\u5b8c\u5168\u91cd\u5408\uff0c\u6cb9\u58a8\u8fb9\u7f18\u5e72\u51c0\u5229\u843d\uff0c\u65e0\u4efb\u4f55\u91cd\u5f71\u3002</p>"},{"location":"#2-the-certifying-statement","title":"2. \u5f15\u5bfc\u8bcd\uff08The Certifying Statement\uff09","text":"<p>\u5fbd\u6807\u4e0b\u65b9\u7559\u6709\u4e00\u5b9a\u7684\u89c6\u89c9\u7a7a\u767d\uff0c\u968f\u540e\u662f\u4e00\u884c\u4f18\u96c5\u7684\u659c\u4f53\u8fc7\u6e21\u6587\u5b57\uff1a\u201cThis is to certify that\u201d\uff08\u7279\u6b64\u8bc1\u660e\uff09\u3002\u8fd9\u884c\u5b57\u62c9\u5f00\u4e86\u6838\u5fc3\u4fe1\u606f\u533a\u57df\u7684\u5e8f\u5e55\u3002</p>"},{"location":"#_3","title":"\u6bd5\u4e1a\u751f\u4e2a\u4eba\u4fe1\u606f\u4e0e\u5b66\u4f4d\u540d\u79f0\u6392\u7248\u7279\u5f81","text":"<p>\u8bc1\u4e66\u4e2d\u90e8\u7528\u4e8e\u627f\u8f7d\u6700\u5173\u952e\u7684\u5b66\u672f\u6388\u8854\u4fe1\u606f\uff0c\u5176\u5b57\u4f53\u7684\u7c97\u7ec6\u5bf9\u6bd4\u548c\u6362\u884c\u903b\u8f91\u6709\u7740\u4e25\u5bc6\u7684\u89c4\u8303\u3002</p>"},{"location":"#1-graduate-identity","title":"1. \u6bd5\u4e1a\u751f\u59d3\u540d\uff08Graduate Identity\uff09","text":"<p>\u5728\u8fc7\u6e21\u5f15\u5bfc\u8bcd\u4e0b\u65b9\uff0c\u4e3a\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u59d3\u540d\uff08\u6216\u62fc\u97f3\u5168\u79f0\uff09\u3002 * \u6392\u7248\u89c4\u8303\uff1a \u59d3\u540d\u901a\u5e38\u91c7\u7528\u52a0\u5927\u5b57\u53f7\u7684\u7c97\u4f53\u6216\u886c\u7ebf\u4f53\uff0c\u5c45\u4e2d\u5bf9\u9f50\u3002\u5728\u6838\u9a8c\u539f\u4ef6\u65f6\uff0c\u8be5\u59d3\u540d\u7684\u62fc\u5199\u548c\u987a\u5e8f\u5fc5\u987b\u4e0e\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u62a4\u7167\u4ee5\u53ca\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u7684\u8ba4\u8bc1\u4fe1\u606f\u5b8c\u5168\u4e00\u81f4\u3002</p>"},{"location":"#2-the-awarding-clause","title":"2. \u6388\u8854\u5ba3\u544a\u8bcd\uff08The Awarding Clause\uff09","text":"<p>\u59d3\u540d\u4e0b\u65b9\u7d27\u63a5\u7740\u4e09\u884c\u8f83\u5c0f\u5b57\u53f7\u7684\u8bf4\u660e\u6587\u672c\uff1a * \u201chaving met the requirements of the course\u201d * \u201capproved by the University as leading to the\u201d \u8fd9\u4e24\u884c\u5b57\u8bf4\u660e\u6bd5\u4e1a\u751f\u5df2\u8fbe\u5230\u4e86\u5b66\u6821\u89c4\u5b9a\u7684\u8bfe\u7a0b\u8981\u6c42\uff0c\u6b63\u5f0f\u5f15\u51fa\u4e0b\u65b9\u7684\u6700\u9ad8\u5b66\u4f4d\u540d\u79f0\u3002</p>"},{"location":"#3-degree-with-major","title":"3. \u5b66\u4f4d\u4e0e\u4e13\u4e1a\u65b9\u5411\uff08Degree with Major\uff09","text":"<p>\u8fd9\u662f\u6574\u4e2a\u8bc1\u4e66\u4e2d\u5b57\u53f7\u6700\u5927\u3001\u6700\u5f15\u4eba\u6ce8\u76ee\u7684\u6838\u5fc3\u6587\u672c\u3002\u4ee5\u5efa\u7b51\u4e0e\u8bbe\u8ba1\u7c7b\u4e13\u4e1a\u6837\u672c\u4e3a\u4f8b\uff0c\u901a\u5e38\u5206\u4e3a\u4e09\u884c\u5927\u5199\u52a0\u7c97\u5b57\u4f53\u6392\u7248\uff1a * BACHELOR OF THE BUILT * ENVIRONMENT (INTERIOR * ARCHITECTURE) \u610f\u4e3a\uff1a\u5efa\u7b51\u73af\u5883\u5b66\u58eb\uff08\u5ba4\u5185\u5efa\u7b51\u65b9\u5411\uff09\u3002 * \u6838\u9a8c\u8981\u70b9\uff1a \u8fd9\u4e00\u533a\u57df\u7684\u6587\u672c\u4e0d\u4ec5\u5b57\u53f7\u5927\uff0c\u800c\u4e14\u5b57\u95f4\u8ddd\u548c\u884c\u95f4\u8ddd\u7ecf\u8fc7\u7cbe\u5bc6\u5fae\u8c03\u3002\u5728\u771f\u5b9e\u7684\u8bc1\u4e66\u4e0a\uff0c\u5373\u4f7f\u662f\u5e26\u6709\u62ec\u53f7\u7684\u4e13\u4e1a\u65b9\u5411\u540e\u7f00\uff0c\u5176\u6574\u4f53\u89c6\u89c9\u91cd\u5fc3\u4f9d\u7136\u7a33\u7a33\u843d\u5728\u8bc1\u4e66\u7684\u4e2d\u5fc3\u5782\u76f4\u7ebf\u4e0a\u3002</p>"},{"location":"#_4","title":"\u8bc1\u4e66\u5e95\u90e8\u6cd5\u5f8b\u6548\u529b\u3001\u65e5\u671f\u4e0e\u53cc\u7b7e\u7ae0\u6838\u5bf9","text":"<p>\u8bc1\u4e66\u7684\u540e\u534a\u90e8\u5206\u8fdb\u5165\u6cd5\u5f8b\u6548\u529b\u5ba3\u544a\u548c\u5b66\u6821\u6cd5\u5b9a\u4ee3\u8868\u4eba\u7684\u7b7e\u7ae0\u533a\u57df\uff0c\u662f\u5224\u5b9a\u8bc1\u4e66\u662f\u5426\u5177\u6709\u5408\u6cd5\u6548\u529b\u7684\u6838\u5fc3\u4f9d\u636e\u3002</p>"},{"location":"#1-the-council-authority","title":"1. \u6cd5\u5f8b\u6388\u6743\u5ba3\u8a00\uff08The Council Authority\uff09","text":"<p>\u5728\u5b66\u4f4d\u540d\u79f0\u4e0b\u65b9\uff0c\u5370\u6709\u5982\u4e0b\u5e84\u91cd\u7684\u6cd5\u7406\u5ba3\u544a\uff1a * \u201cwas with the authority of the Council\u201d\uff08\u7ecf\u5927\u5b66\u7406\u4e8b\u4f1a\u6388\u6743\uff09 * \u201cduly admitted to that award on the\u201d\uff08\u6b63\u5f0f\u6388\u4e88\u8be5\u8363\u8a89\u4e8e\uff09 * second day of April 2022\uff082022\u5e744\u67082\u65e5\uff09 * \u201cGiven under the seal of the University\u201d\uff08\u5728\u5927\u5b66\u5370\u7ae0\u89c1\u8bc1\u4e0b\u9881\u53d1\uff09</p> <p>\u6ce8\u610f\uff1a \u6bd5\u4e1a\u5178\u793c\u6216\u5b66\u4f4d\u6388\u4e88\u65e5\u671f\u901a\u5e38\u4f1a\u7528\u82f1\u6587\u5e8f\u6570\u8bcd\u548c\u5b8c\u6574\u6708\u4efd\u3001\u5e74\u4efd\u5c55\u5f00\u62fc\u5199\uff08\u5982 second day of April 2022\uff09\uff0c\u5b57\u5f62\u7ea4\u7ec6\u4f18\u7f8e\u3002</p>"},{"location":"#2-the-university-seal","title":"2. \u4eae\u84dd\u8272\u6fc0\u5149\u9632\u4f2a\u94a2\u5370\uff08The University Seal\uff09","text":"<p>\u5728\u8bc1\u4e66\u7684\u5de6\u4e0b\u89d2\uff0c\u52a0\u76d6\u6709\u4e00\u4e2a\u6781\u5176\u8000\u773c\u7684\u4eae\u84dd\u8272\u5168\u606f/\u6fc0\u5149\u611f\u9632\u4f2a\u94a2\u5370\u3002 * \u5916\u89c2\u7279\u5f81\uff1a \u8be5\u5370\u7ae0\u4e3a\u6b63\u5706\u5f62\uff0c\u5916\u5708\u73af\u7ed5\u7740\u201cUNIVERSITY OF CANBERRA\u201d\u7684\u9542\u7a7a\u5927\u5199\u5b57\u6837\uff0c\u5185\u5708\u5219\u5d4c\u5957\u7740\u4e0e\u8bc1\u4e66\u9876\u90e8\u4e00\u6a21\u4e00\u6837\u7684\u516d\u74e3\u73af\u72b6\u5fbd\u6807\u3002 * \u5de5\u827a\u8981\u70b9\uff1a \u771f\u5b9e\u7684\u9632\u4f2a\u5370\u7ae0\u91c7\u7528\u7684\u662f\u9ad8\u7cbe\u5ea6\u7acb\u4f53\u538b\u5370\uff08\u94a2\u5370\uff09\u7ed3\u5408\u7279\u6b8a\u53cd\u5149\u6750\u8d28\u5de5\u827a\u3002\u7528\u624b\u89e6\u6478\u7eb8\u5f20\u80cc\u9762\u53ef\u4ee5\u611f\u53d7\u5230\u660e\u663e\u7684\u51f9\u9677\uff0c\u6b63\u9762\u5219\u5fae\u5fae\u51f8\u8d77\u3002\u5728\u4e0d\u540c\u5149\u7ebf\u89d2\u5ea6\u4e0b\uff0c\u4eae\u84dd\u8272\u4f1a\u5448\u73b0\u51fa\u91d1\u5c5e\u8d28\u611f\u7684\u6298\u5c04\u5149\u6cfd\u3002 * \u5e95\u90e8\u5e8f\u5217\u53f7\uff1a \u8be5\u94a2\u5370\u6b63\u4e0b\u65b9\u901a\u5e38\u4f1a\u5370\u6709\u4e00\u4e32\u7ec6\u5c0f\u7684\u6570\u5b57\u8bc1\u4e66\u5e8f\u5217\u53f7\uff08\u5982\u201c602345\u201d\uff09\uff0c\u7528\u4e8e\u5b66\u6821\u5185\u90e8\u6863\u6848\u7684\u5feb\u901f\u68c0\u7d22\u3002</p>"},{"location":"#3-official-signatures","title":"3. \u6821\u65b9\u9ad8\u5c42\u53cc\u7b7e\u7ae0\uff08Official Signatures\uff09","text":"<p>\u53f3\u4e0b\u89d2\u5e76\u6392\u5370\u6709\u5b66\u6821\u4e24\u4f4d\u6700\u9ad8\u8d1f\u8d23\u4eba\u7684\u6cd5\u5b9a\u7b7e\u540d\uff1a * \u5de6\u4fa7\uff1a Vice-Chancellor\uff08\u6821\u957f/\u526f\u6821\u76d1\uff09\u7684\u7b7e\u540d\u3002 * \u53f3\u4fa7\uff1a Chancellor\uff08\u6821\u76d1/\u5927\u5b66\u8463\u4e8b\u4f1a\u4e3b\u5e2d\uff09\u7684\u7b7e\u540d\u3002 * \u6838\u9a8c\u8981\u70b9\uff1a \u4e24\u4e2a\u7b7e\u540d\u7684\u4e0b\u65b9\u5747\u6709\u660e\u786e\u7684\u804c\u4f4d\u5370\u5237\u5b57\u6837\u8fdb\u884c\u5bf9\u9f50\u3002\u771f\u5b9e\u7684\u7b7e\u540d\u7ebf\u6761\u4e00\u6c14\u5475\u6210\uff0c\u5e26\u6709\u5f3a\u70c8\u7684\u4e2a\u4eba\u4e66\u5199\u98ce\u683c\u548c\u7b14\u950b\u7c97\u7ec6\u53d8\u5316\uff0c\u7edd\u65e0\u50cf\u7d20\u9897\u7c92\u611f\u6216\u6a21\u7cca\u65ad\u7ebf\u73b0\u8c61\u3002</p>"},{"location":"#_5","title":"\u603b\u7ed3","text":"<p>\u5bf9\u582a\u57f9\u62c9\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08University of Canberra diploma\uff09\u7684\u53c2\u7167\u6bd4\u5bf9\uff0c\u5e94\u5f53\u9075\u5faa\u201c\u4ece\u6574\u4f53\u5230\u5c40\u90e8\u3001\u4ece\u5370\u5237\u5230\u5de5\u827a\u201d\u7684\u4e25\u8c28\u6d41\u7a0b\u3002\u771f\u5b9e\u7684\u5b66\u4f4d\u8bc1\u4e66\u5728\u9876\u90e8\u7684\u5929\u84dd\u8272\u5fbd\u6807\u3001\u4e2d\u90e8\u7684\u4e2d\u5fc3\u8f74\u5bf9\u79f0\u6392\u7248\u3001\u5de6\u4e0b\u89d2\u7684\u4eae\u84dd\u8272\u9ad8\u7cbe\u5ea6\u51f9\u51f8\u94a2\u5370\u4ee5\u53ca\u53f3\u4e0b\u89d2\u6d41\u7545\u7684\u53cc\u7b7e\u7ae0\u4e0a\uff0c\u90fd\u5c55\u73b0\u51fa\u4e86\u73b0\u4ee3\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u6587\u4ef6\u6781\u9ad8\u7684\u5236\u4f5c\u6c34\u51c6\u3002\u638c\u63e1\u8fd9\u4e9b\u6838\u5fc3\u7684\u6392\u7248\u7279\u5f81\u4e0e\u9632\u4f2a\u7ec6\u8282\uff0c\u80fd\u591f\u4e3a\u6d77\u5f52\u4eba\u624d\u7684\u8eab\u4efd\u6838\u9a8c\u4e0e\u7528\u4eba\u5355\u4f4d\u7684\u98ce\u9669\u9632\u8303\u63d0\u4f9b\u575a\u5b9e\u7684\u6280\u672f\u652f\u6491\u3002</p>"}]}